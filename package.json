{
  "name": "runner",
  "version": "1.0.0",
  "private": false,
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/ste163/runner"
  },
  "type": "module",
  "scripts": {
    "build": "sparkling-app-cli build --copy",
    "dev": "sh ./scripts/android-dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src app.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src app.config.ts vitest.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@lynx-js/react": "0.121.0",
    "sparkling-navigation": "2.0.1"
  },
  "devDependencies": {
    "@lynx-js/qrcode-rsbuild-plugin": "0.4.7",
    "@lynx-js/react-rsbuild-plugin": "0.16.2",
    "@lynx-js/rspeedy": "0.14.4",
    "@lynx-js/types": "3.9.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "18.3.29",
    "@vitest/coverage-v8": "4.1.7",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "sparkling-app-cli": "2.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "^22 || ^24"
  }
}

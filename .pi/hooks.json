{
  "tool_call": {
    "command": "sh scripts/hooks/pre-tool.sh",
    "tools": ["bash"]
  },
  "agent_settled": {
    "command": "sh scripts/hooks/verify.sh",
    "when": "dirty",
    "status": "Verification Checks",
    "paths": [
      "src/**",
      "scripts/**",
      ".agents/**",
      ".pi/**",
      "app.config.ts",
      "lynx.config.ts",
      "vitest.config.ts",
      "AGENTS.md",
      "package.json"
    ]
  }
}

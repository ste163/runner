{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/pre-tool.sh",
        "matcher": "bash",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash .github/hooks/verify.sh",
        "cwd": ".",
        "timeoutSec": 60
      }
    ]
  }
}
